{
  "crons": [
    {
      "path": "/api/cron/usage-alerts",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/story-anniversary",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/cron/limpiar-subidas",
      "schedule": "10 7 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/mapa",
      "destination": "/?section=mapa",
      "permanent": true
    },
    {
      "source": "/mapa/",
      "destination": "/?section=mapa",
      "permanent": true
    }
  ],
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]; then exit 0; fi; git diff --quiet HEAD^ HEAD -- . ':!.github' ':!docs' ':!e2e' 2>/dev/null && exit 0 || exit 1",
  "headers": [
    {
      "source": "/temas",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/temas/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/exposiciones",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/exposiciones/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/recorridos",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/recorridos/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/vision",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/educacion-mediatica",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
